# Salin file ini menjadi .env.local (JANGAN di-commit) lalu isi dari
# Supabase Dashboard → Project Settings → API Keys / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret key / service_role HANYA untuk server (mis. fitur undang pengguna nanti).
# Jangan beri awalan NEXT_PUBLIC_ dan jangan pernah dipakai di komponen klien.
# SUPABASE_SECRET_KEY=
